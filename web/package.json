{
  "name": "dumbmonit-web",
  "version": "0.17.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --output-structure locale-modules --emit-ts-declarations --silent && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "i18n:merge": "node scripts/merge-messages.mjs",
    "i18n:check": "node scripts/merge-messages.mjs --check"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "@inlang/plugin-message-format": "^4.5.7",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/leaflet": "^1.9.22",
    "simple-icons": "^16.36.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-svelte": "^1.0.1",
    "qrcode-generator": "^2.0.4",
    "uplot": "^1.6.32"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
