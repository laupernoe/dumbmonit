{
  "name": "dumbmonit-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "i18n:merge": "node scripts/merge-messages.mjs",
    "i18n:check": "node scripts/merge-messages.mjs --check"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.26.0",
    "@inlang/plugin-message-format": "^4.4.5",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "shadcn": "^4.21.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "lucide-svelte": "^1.0.1",
    "qrcode-generator": "^2.0.4",
    "uplot": "^1.6.32"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
