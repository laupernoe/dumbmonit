package="dumbmonit-agent"
version="@VERSION@"
os_min_ver="7.0-40000"
arch="@SPK_ARCH@"
displayname="DumbMonit Agent"
description="Reports this NAS (CPU, memory, disks, network) to your DumbMonit server. Outbound connections only."
maintainer="DumbMonit"
maintainer_url="https://github.com/selfhostr/dumbmonit"
dsmuidir="ui"
silent_install="no"
silent_upgrade="yes"
silent_uninstall="yes"
startable="yes"
thirdparty="yes"
