[
    {
        "step_title": "DumbMonit server",
        "items": [
            {
                "desc": "Enter the address of your DumbMonit server and an enrollment token (DumbMonit: Add monitor, Server with the agent). The token is used once, to enroll this NAS."
            },
            {
                "type": "textfield",
                "subitems": [
                    {
                        "key": "wizard_server_url",
                        "desc": "Server URL (for example http://192.168.1.10:8080)",
                        "defaultValue": "",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^https?:\\/\\/[A-Za-z0-9._:\\/\\[\\]-]+$/",
                                "errorText": "Enter a URL starting with http:// or https://"
                            }
                        }
                    }
                ]
            },
            {
                "type": "password",
                "subitems": [
                    {
                        "key": "wizard_token",
                        "desc": "Enrollment token",
                        "defaultValue": "",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^[A-Za-z0-9_.-]+$/",
                                "errorText": "The token only contains letters, digits, underscore, dot and dash"
                            }
                        }
                    }
                ]
            }
        ]
    }
]
